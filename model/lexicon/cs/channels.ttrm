package hartland

model lexicon locale cs

// D-6 channel vocabulary, Czech forms — the SAME `for:` targets as en/channels.ttrm (the
// "one model, two locales" invariant Stage 2.5 T5/T6 check).

def term marketplace_channel_cs {
    description: "tržiště synonyma"
    for: er.entity.catalog_sales
    forms: ["tržiště", "e=market", "market"]
}

def term web_channel_cs {
    description: "web synonyma"
    for: er.entity.web_sales
    forms: ["web", "online", "e-shop"]
}

def term store_channel_cs {
    description: "prodejny synonyma"
    for: er.entity.store_sales
    // ✅MH-D6 (2026-09-02): the bare word STAYS, deliberately. `prodejna` is also
    // `er.entity.store`'s `displayLabel.cs`, so two refs claim it — a dimension (six rows) and
    // the fact this channel term is pinned to. That is the collision the MH effort exists for,
    // and an MH resolver decides it from the sentence: `kolik prodejen` counts the dimension,
    // `srovnej prodejny a web` compares channels, `tržby z prodejen` binds the dimension and
    // records the channel as an equal reading, `prodejna` alone still asks. Dropping the word
    // would erase the channel meaning instead of differentiating it (design.md T1 §4).
    // See project/server/features/mention-homonymy/.
    // ttr-disable-next-line lexicon-form-collides-with-name
    forms: ["prodejna", "kamenná prodejna", "obchod"]
}
