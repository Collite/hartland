package investment

model query

// IE-C25 — the nine `q.investment.*` pattern queries. Shape and precedent:
// `Collite/hartland/model/queries/q_hartland.ttrm`. The last two — `period_values` and
// `portfolio_header` — joined at IE-P3·S3.1 for the report.
//
// ## What these are, and what they are not
//
// SQL over the PHYSICAL `investment_*` tables, PostgreSQL dialect, `{param}` placeholders — the
// same thing hartland's queries do when they name `store_sales`. The `er` layer beside this file
// (S2.1) is what the Golem READS to understand the estate; these are what the query door RUNS.
// TTR-P-authored patterns over the er star are the aspiration; `def query` with `language: SQL` is
// what the door and the Golem consume today, and the demo does not wait for the aspiration.
//
// ## The CTE is repeated verbatim, on purpose
//
// `def query` has no include directive. The effective-ledger CTE below therefore appears in full in
// every query that touches the ledger, and `tests/effective-ledger.cte.sql` holds the one true copy
// with `tests/queries.test.mjs` T1.6 asserting the verbatim match. Editing a copy in place without
// editing the file is the one mistake this arrangement is built to catch — five near-identical
// queries is exactly the shape where a fix lands in four of them.
//
// Read `tests/effective-ledger.cte.sql`'s header before changing any sign or any operation name.
// It records why the two numeric columns follow OPPOSITE conventions and why the book has two
// unrelated reversal mechanisms.
//
// ## SCD2 lives here too
//
// `investment_client`, `investment_portfolio` and `investment_position` are effective-dated, and
// the binding cannot say so (IE-P0 V9 — `whereFilter` parses and is then dropped by ttr-metadata
// and veles, so writing it would claim a rule nothing enforces). `valid_to IS NULL` in the query
// text is therefore not a duplicate of a binding rule: it is the ONLY place the rule exists. Drop
// it from one query and that query silently returns every historical version of every row.

def query portfolios_of_client {
    description: "Every portfolio a client currently holds, with its base currency, its state and the date the client's first version of it opened."
    language: SQL
    sourceText: """
        SELECT p.external_id   AS portfolio_id,
               p.label         AS name,
               p.base_currency,
               p.state,
               (SELECT min(v.valid_from)
                  FROM investment_portfolio v
                 WHERE v.external_id = p.external_id) AS since
        FROM investment_portfolio p
        JOIN investment_client c
          ON c.external_id = p.client_ref
         AND c.valid_to IS NULL
        WHERE p.valid_to IS NULL
          AND c.external_id = {client_id}
        ORDER BY p.external_id
    """
    search {
        patterns: [
            "(which |what )?portfolios (of|for|belonging to) (the )?client",
            "(list|show) (the )?client'?s? portfolios",
            "portfolia klienta",
            "(jaka|ktera) portfolio (ma|drzi) klient"
        ],
        examples: [
            "Which portfolios does this client hold?",
            "Která portfolia má tento klient?"
        ]
    }
    parameters: [
        { name: client_id, type: text, label: "Client id (conseq:<CsqClientId>)" }
    ]
}

def query positions_current {
    description: "The portfolio's holdings at its latest valuation, each joined to the instrument and to the last price known on that valuation date."
    language: SQL
    sourceText: """
        -- ⛔ "Latest" is the latest valuation OF THE PORTFOLIO, not of each instrument (review-089 ⑶).
        -- A valuation pull values the whole portfolio on ONE date, and a position's key includes that
        -- date — so scd2 never closes the last row of an instrument the portfolio has since SOLD
        -- (it closes a row only when the same key comes back). Partitioning by instrument therefore
        -- listed every instrument ever held, each at its own last valuation. The instrument join is a
        -- LEFT join for the same reason `positions_at`'s is: an instrument the book has no row for is
        -- still a holding, named by its ISIN.
        WITH open_position AS (
          SELECT p.portfolio_ref,
                 p.asset_ref,
                 p.valuation_date,
                 p.quantity,
                 p.market_value,
                 MAX(p.valuation_date) OVER () AS latest_valuation
          FROM investment_position p
          WHERE p.valid_to IS NULL
            AND p.portfolio_ref = {portfolio_id}
        )
        SELECT pos.portfolio_ref AS portfolio_id,
               pos.asset_ref     AS isin,
               COALESCE(a.name, pos.asset_ref) AS asset_name,
               a.asset_class     AS kind,
               pos.valuation_date,
               pos.quantity,
               pos.market_value,
               pr.price          AS last_price,
               pr.price_date     AS last_price_date
        FROM open_position pos
        LEFT JOIN investment_asset a
          ON a.isin = pos.asset_ref
        LEFT JOIN investment_asset_price pr
          ON pr.isin = pos.asset_ref
         AND pr.price_date = (SELECT MAX(p2.price_date)
                                FROM investment_asset_price p2
                               WHERE p2.isin = pos.asset_ref
                                 AND p2.price_date <= pos.valuation_date)
        WHERE pos.valuation_date = pos.latest_valuation
        ORDER BY pos.asset_ref
    """
    search {
        patterns: [
            "(current|latest) positions (in|of|for) (the )?portfolio",
            "what (do|does) (i|the portfolio) (own|hold) (now|currently)?",
            "aktualni pozice v portfoliu",
            "co je (nyni|ted) v portfoliu"
        ],
        examples: [
            "What are the current positions in the portfolio?",
            "Jaké jsou aktuální pozice v portfoliu?"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" }
    ]
}

def query cash_balance {
    description: "The cash sitting in a portfolio on a given day, per currency — the signed sum of the cash leg only, never the external-flow leg beside it."
    language: SQL
    sourceText: """
        WITH effective_ledger AS (
          SELECT t.*,
                 CASE
                   WHEN t.leg = 'security' AND t.operation IN ('buy', 'transfer-in', 'reversal-of-sell')
                     THEN  COALESCE(abs(t.quantity), 0)
                   WHEN t.leg = 'security' AND t.operation IN ('sell', 'transfer-out', 'payout', 'reversal-of-buy')
                     THEN -COALESCE(abs(t.quantity), 0)
                   ELSE 0
                 END AS qty_signed,
                 CASE
                   WHEN t.leg = 'cash'          AND t.operation = 'credit'     THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'cash'          AND t.operation = 'debit'      THEN -COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'deposit'    THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'withdrawal' THEN -COALESCE(abs(t.amount), 0)
                   ELSE 0
                 END AS amt_signed
          FROM investment_transaction t
          WHERE t.reversal_of IS NULL
            AND NOT EXISTS (SELECT 1 FROM investment_transaction r WHERE r.reversal_of = t.external_id)
        )
        SELECT {portfolio_id} AS portfolio_id,
               currency,
               SUM(amt_signed) AS cash_balance
        FROM effective_ledger
        WHERE portfolio_ref = {portfolio_id}
          AND leg = 'cash'
          AND trade_date <= {as_of}
        GROUP BY currency
        ORDER BY currency
    """
    search {
        patterns: [
            "(how much |what is the )?cash (balance|position) (in|of|on)",
            "(free|available|uninvested) cash",
            "hotovost v portfoliu",
            "zustatek hotovosti k datu"
        ],
        examples: [
            "How much cash is in the portfolio?",
            "Kolik hotovosti je v portfoliu k dnešnímu dni?"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" },
        { name: as_of, type: date, label: "As of date" }
    ]
}

def query transactions_recent {
    description: "The portfolio's effective movements since a date, newest first — reversed movements and the rows that reversed them are already gone."
    language: SQL
    sourceText: """
        WITH effective_ledger AS (
          SELECT t.*,
                 CASE
                   WHEN t.leg = 'security' AND t.operation IN ('buy', 'transfer-in', 'reversal-of-sell')
                     THEN  COALESCE(abs(t.quantity), 0)
                   WHEN t.leg = 'security' AND t.operation IN ('sell', 'transfer-out', 'payout', 'reversal-of-buy')
                     THEN -COALESCE(abs(t.quantity), 0)
                   ELSE 0
                 END AS qty_signed,
                 CASE
                   WHEN t.leg = 'cash'          AND t.operation = 'credit'     THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'cash'          AND t.operation = 'debit'      THEN -COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'deposit'    THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'withdrawal' THEN -COALESCE(abs(t.amount), 0)
                   ELSE 0
                 END AS amt_signed
          FROM investment_transaction t
          WHERE t.reversal_of IS NULL
            AND NOT EXISTS (SELECT 1 FROM investment_transaction r WHERE r.reversal_of = t.external_id)
        )
        SELECT external_id AS transaction_id,
               trade_date,
               leg,
               operation,
               asset_ref AS isin,
               quantity,
               qty_signed,
               amount,
               amt_signed,
               currency
        FROM effective_ledger
        WHERE portfolio_ref = {portfolio_id}
          AND trade_date >= {since}
        ORDER BY trade_date DESC, external_id DESC
    """
    search {
        patterns: [
            "(recent|latest|last) transactions",
            "(what|which) (movements|trades|transactions) since",
            "posledni transakce",
            "obchody od (data|ledna|dubna)"
        ],
        examples: [
            "Show the recent transactions since April",
            "Ukaž poslední transakce od dubna"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" },
        { name: since, type: date, label: "Since date (inclusive)" }
    ]
}

def query transactions_between {
    description: "The portfolio's effective movements in a closed date window, oldest first — the report's Transactions sheet."
    language: SQL
    sourceText: """
        WITH effective_ledger AS (
          SELECT t.*,
                 CASE
                   WHEN t.leg = 'security' AND t.operation IN ('buy', 'transfer-in', 'reversal-of-sell')
                     THEN  COALESCE(abs(t.quantity), 0)
                   WHEN t.leg = 'security' AND t.operation IN ('sell', 'transfer-out', 'payout', 'reversal-of-buy')
                     THEN -COALESCE(abs(t.quantity), 0)
                   ELSE 0
                 END AS qty_signed,
                 CASE
                   WHEN t.leg = 'cash'          AND t.operation = 'credit'     THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'cash'          AND t.operation = 'debit'      THEN -COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'deposit'    THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'withdrawal' THEN -COALESCE(abs(t.amount), 0)
                   ELSE 0
                 END AS amt_signed
          FROM investment_transaction t
          WHERE t.reversal_of IS NULL
            AND NOT EXISTS (SELECT 1 FROM investment_transaction r WHERE r.reversal_of = t.external_id)
        )
        SELECT external_id AS transaction_id,
               trade_date,
               leg,
               operation,
               asset_ref AS isin,
               quantity,
               qty_signed,
               amount,
               amt_signed,
               currency
        FROM effective_ledger
        WHERE portfolio_ref = {portfolio_id}
          AND trade_date >= {from_date}
          AND trade_date <= {to_date}
        ORDER BY trade_date, external_id
    """
    search {
        patterns: [
            "transactions between .* and",
            "(movements|trades) (in|during|for) (the )?(period|quarter|window)",
            "transakce mezi (daty|obdobim)",
            "obchody za obdobi"
        ],
        examples: [
            "Transactions between January and June",
            "Transakce mezi lednem a červnem"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" },
        { name: from_date, type: date, label: "From date (inclusive)" },
        { name: to_date, type: date, label: "To date (inclusive)" }
    ]
}

def query positions_at {
    description: "What the portfolio held on a given day, valued at the last price known by then, with the cash balance as a final line."
    language: SQL
    sourceText: """
        WITH effective_ledger AS (
          SELECT t.*,
                 CASE
                   WHEN t.leg = 'security' AND t.operation IN ('buy', 'transfer-in', 'reversal-of-sell')
                     THEN  COALESCE(abs(t.quantity), 0)
                   WHEN t.leg = 'security' AND t.operation IN ('sell', 'transfer-out', 'payout', 'reversal-of-buy')
                     THEN -COALESCE(abs(t.quantity), 0)
                   ELSE 0
                 END AS qty_signed,
                 CASE
                   WHEN t.leg = 'cash'          AND t.operation = 'credit'     THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'cash'          AND t.operation = 'debit'      THEN -COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'deposit'    THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'withdrawal' THEN -COALESCE(abs(t.amount), 0)
                   ELSE 0
                 END AS amt_signed
          FROM investment_transaction t
          WHERE t.reversal_of IS NULL
            AND NOT EXISTS (SELECT 1 FROM investment_transaction r WHERE r.reversal_of = t.external_id)
        )
        , holdings AS (
          SELECT asset_ref, SUM(qty_signed) AS quantity
          FROM effective_ledger
          WHERE portfolio_ref = {portfolio_id}
            AND leg = 'security'
            AND trade_date <= {as_of}
          GROUP BY asset_ref
          HAVING SUM(qty_signed) <> 0
        ), cash AS (
          SELECT currency, SUM(amt_signed) AS balance
          FROM effective_ledger
          WHERE portfolio_ref = {portfolio_id}
            AND leg = 'cash'
            AND trade_date <= {as_of}
          GROUP BY currency
        ), latest_price AS (
          -- The last price known for each instrument on or before the as-of day. Written as a
          -- grouped MAX joined back, rather than the LATERAL ... ORDER BY ... LIMIT 1 it replaces:
          -- the query door lowers a LATERAL-with-LIMIT to FIRST_VALUE, and ranking window functions
          -- are not in the plan.v1 wire format (S2.3·D1). Written as an explicit join and not as a
          -- CORRELATED `price_date = (SELECT MAX(...) WHERE p2.isin = ap.isin)`, which reads better
          -- and which the door also refuses: decorrelating it emits `IS NOT DISTINCT FROM` on the
          -- nullable join key, and that operator is not in the wire format either. An instrument
          -- that has never been priced is absent here and reaches the outer LEFT JOIN as NULL,
          -- which is the point.
          -- `price_currency`, not `currency`: the holding line joins this AND `investment_asset`, and
          -- both carry a `currency`. psql resolves the qualified names happily; the door does not —
          -- Calcite renames the second to `currency0` and the PostgreSQL unparse then fails with
          -- `field [currency0] not found` (measured through ttr-translator, review-089). Never let
          -- one row carry the same column name twice in a program the door runs.
          SELECT ap.isin, ap.price, ap.price_date, ap.currency AS price_currency
          FROM investment_asset_price ap
          JOIN (SELECT p2.isin AS isin, MAX(p2.price_date) AS as_of_price_date
                  FROM investment_asset_price p2
                 WHERE p2.price_date <= {as_of}
                 GROUP BY p2.isin) m
            ON m.isin = ap.isin
           AND m.as_of_price_date = ap.price_date
        )
        -- ⛔ review-089 ⑵: a holding's `market_value` is units × price, so it is in the PRICE's
        -- currency, and a portfolio can hold a EUR fund beside CZK ones (the connector's own
        -- valuation fixture does). Every line therefore says its currency, and nothing here sums
        -- across one. ⛔ review-089 ⑷: the instrument join is a LEFT join. `investment_asset` is
        -- written only by the date-less valuation leg, which answers with CURRENT holdings, so an
        -- instrument bought and sold before the connector's first sync has trades and prices and no
        -- asset row — and an inner join made it vanish from every historical date.
        SELECT x.line_id, x.line_name, x.quantity, x.last_price, x.last_price_date, x.market_value,
               x.currency, x.line_rank
        FROM (
          SELECT h.asset_ref        AS line_id,
                 COALESCE(a.name, h.asset_ref) AS line_name,
                 h.quantity,
                 CAST(pr.price AS FLOAT) AS last_price,
                 pr.price_date      AS last_price_date,
                 h.quantity * pr.price AS market_value,
                 COALESCE(pr.price_currency, a.currency) AS currency,
                 0                  AS line_rank
          FROM holdings h
          LEFT JOIN investment_asset a
            ON a.isin = h.asset_ref
          LEFT JOIN latest_price pr
            ON pr.isin = h.asset_ref
          UNION ALL
          SELECT 'CASH:' || c.currency,
                 'Cash (' || c.currency || ')',
                 CAST(NULL AS FLOAT),
                 CAST(NULL AS FLOAT),
                 CAST(NULL AS DATE),
                 c.balance,
                 c.currency,
                 1
          FROM cash c
        ) x
        -- ⛔ NO SCALE IS ASKED FOR ON COMPUTED MONEY, and that is deliberate (S2.3·D6, corrected
        -- at S2.3·D13; ruled by Bora 2026-09-10). `market_value` was written
        -- `CAST(h.quantity * pr.price AS DECIMAL(18,2))`, which reads as "money, to the cent" and
        -- is not what happens: the surface-type lattice a plan travels in is
        -- TEXT/INT/FLOAT/BOOL/DATETIME with NO DECIMAL, so the cast is DISCARDED — silently, with
        -- no error and no warning — and the door emits `CAST(… AS DOUBLE PRECISION)`. The word
        -- `decimal` does not survive anywhere in the plan; measured by unparsing this query through
        -- the door's own translator and grepping the plan proto. So the SAME TEXT answered
        -- differently on the two paths: psql honours the cast and returns `16500.00`, the door
        -- discards it and returns `16500`. Removing it makes the two agree, and puts the rounding
        -- where §2.2 already puts it — the Studio formats, it does not compute.
        -- ⛔ `last_price` IS CAST TO FLOAT, and a stored exact number is deliberately made inexact
        -- (S2.3·D19). Left uncast it is the only column in this answer that reaches the worker as a
        -- bare `numeric` COLUMN rather than as arithmetic: the cash branch contributes a NULL whose
        -- DECIMAL cast the plan erases (D13), so PostgreSQL types the UNION column as an
        -- UNCONSTRAINED `numeric`, JDBC reports its scale as 0, and worker-postgres builds a
        -- `decimal128(38,0)` vector — a stored `2.103100` was delivered as `2`. Not a rounding
        -- difference: a wrong number, silently, in front of a client. `FLOAT` is the one spelling
        -- BOTH parsers take (PostgreSQL's `FLOAT` is `float8`; Calcite refuses `DOUBLE PRECISION`
        -- and PostgreSQL refuses `DOUBLE`), and the door unparses it to `DOUBLE PRECISION`, which
        -- carries the value. The NULL casts in the cash branch follow it for the same reason — they
        -- only align the UNION's column types, and a NULL has no scale to lose either way.
        -- ⚑ This is a WORKAROUND for a runtime defect, not the fix: worker-postgres must not read an
        -- unconstrained `numeric` at the scale JDBC reports for it, which is 0 because the column
        -- has no DECLARED scale rather than because its values are integers —
        -- Collite/tatrman-server#83. Exact money needs a decimal type IN THE PLAN —
        -- Collite/tatrman#129. Moving the arithmetic to the caller does not help: a JavaScript
        -- number is a double too. When #83 lands, the FLOAT cast above can come off and `last_price`
        -- go back to being the exact stored number — and ⛔ NOTHING OFFLINE WILL SAY SO (review-089
        -- ㉒; this line used to claim T1.16 and T3.6 would): psql never truncated, and T1.16 only
        -- refuses decimal casts on computed values. The signal is the issue closing; the proof is
        -- `just investment-dod` (hartland) comparing the door's `last_price` with the book's stored
        -- price, run on an estate whose worker carries the fix, with the cast removed.
        -- ⛔ `line_rank` IS A REAL COLUMN OF THE ANSWER, and it has to be (S2.3·D18). The UNION is
        -- wrapped because PostgreSQL will not ORDER a set operation by an EXPRESSION over its output
        -- columns — but the door then imposes a second rule of its own: **an ORDER BY key that is
        -- not one of the projected columns is HOISTED INTO THE PROJECTION**, so the CASE this used
        -- to sort by came back as an unnamed seventh column called `case`. Measured, three ways:
        -- hiding the key in an inner subquery and trimming it with an outer SELECT does not work
        -- either — the optimiser then DELETES the sort (it is not semantic under a projection) and
        -- the answer comes back unordered; and an ORDER BY over a projected column that is still an
        -- expression (`x.last_price_date IS NULL`) hoists just the same. So the choice is an honest
        -- named column or no ordering at all, and the description promises the cash line comes last.
        -- 0 = holding, 1 = cash: it is the sort key AND the line's kind, which is what the renderer
        -- needs anyway to know which row has no quantity and no price.
        ORDER BY x.line_rank, x.line_id
    """
    search {
        patterns: [
            "positions (at|as of|on) (the end of )?",
            "what did (the portfolio|i) hold (at|on|in)",
            "pozice k datu",
            "co bylo v portfoliu ke konci"
        ],
        examples: [
            "What did the portfolio hold at the end of June?",
            "Co bylo v portfoliu ke konci června?"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" },
        { name: as_of, type: date, label: "As of date" }
    ]
}

// ⛔⛔ THE ONE QUERY THE DOOR CANNOT COMPILE (S2.3·D1c). Everything above was rewritten at S2.3 into
// the intersection of what Calcite parses and what PostgreSQL executes, and measured through the
// door's own translator. This one cannot be: it needs a quarter-end GRID derived from `as_of`, and
// the plan.v1 wire format has no date arithmetic (`INTERVAL` literals are refused outright), no
// `LAG` (window ranking/navigation functions are refused — the format's `Over` carries SUM, COUNT,
// AVG, MIN, MAX and nothing else), no `FILTER (WHERE …)`, and Calcite knows neither `date_trunc`
// nor `generate_series`. The T-SQL `DATEADD` the parser DOES accept is unparsed VERBATIM to
// PostgreSQL, which cannot run it — so even the one date function that compiles does not execute.
//
// ⚑IE-15 was RULED (a) by Bora on 2026-09-10 and BUILT at IE-P3·S3.1: the report renderer computes
// the quarter ends and calls `period_values` (below) once per period through the door, then adds the
// total, the P&L, the return and the coverage itself (report-renderer `QuarterlyEvolution.kt`) —
// the three things that need the previous row, which the door cannot look at.
//
// This query stays AS AUTHORED, in PostgreSQL, as the REFERENCE. It runs where S2.2 proved it —
// `just conform-investment-queries`, directly on PostgreSQL (T3.7, T3.12) — and NOT through
// `POST /api/query/run`. The renderer's assembly of `period_values` is held to the same hand-computed
// expectations to the cent (QuarterlyEvolutionSpec), so the two paths answer one question or a suite
// goes red. `queries.test.mjs` T1.14 keeps the exemption honest: this is the only query allowed to
// carry a PostgreSQL-only construct.
//
// ⚑ Two differences from the report's grid, both deliberate. (1) When `as_of` IS a quarter end this
// query reports it as a partial row after a full row for the quarter before; IE-C30 says the grid is
// "the last `quarters` quarter ends ≤ as_of", so the renderer reports that quarter once, not partial.
// (2) Veles still serves this query — as PARSE_STATUS_FAILED — with its search patterns, so a Golem
// that picks it for a quarterly question gets a refusal; IE-P4's area work points such questions at
// the report instead.
def query quarterly_evolution {
    description: "The portfolio quarter by quarter and currency by currency: what it was worth, what came in or went out (money and in-kind transfers alike), what that left as profit, and how well the prices behind the number were known."
    language: SQL
    sourceText: """
        WITH effective_ledger AS (
          SELECT t.*,
                 CASE
                   WHEN t.leg = 'security' AND t.operation IN ('buy', 'transfer-in', 'reversal-of-sell')
                     THEN  COALESCE(abs(t.quantity), 0)
                   WHEN t.leg = 'security' AND t.operation IN ('sell', 'transfer-out', 'payout', 'reversal-of-buy')
                     THEN -COALESCE(abs(t.quantity), 0)
                   ELSE 0
                 END AS qty_signed,
                 CASE
                   WHEN t.leg = 'cash'          AND t.operation = 'credit'     THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'cash'          AND t.operation = 'debit'      THEN -COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'deposit'    THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'withdrawal' THEN -COALESCE(abs(t.amount), 0)
                   ELSE 0
                 END AS amt_signed
          FROM investment_transaction t
          WHERE t.reversal_of IS NULL
            AND NOT EXISTS (SELECT 1 FROM investment_transaction r WHERE r.reversal_of = t.external_id)
        )
        , period AS (
          SELECT (date_trunc('quarter', ({as_of})::date)
                  - make_interval(months => 3 * g.i)
                  - interval '1 day')::date AS period_end,
                 FALSE AS partial
          FROM generate_series(0, ({quarters})::int) AS g(i)
          UNION ALL
          SELECT ({as_of})::date, TRUE
        ), bounds AS (
          -- each period with the end of the one before it: flows count in (prev_end, period_end]
          SELECT p.period_end, p.partial,
                 LAG(p.period_end) OVER (ORDER BY p.period_end) AS prev_end
          FROM period p
        ), holdings AS (
          SELECT p.period_end, e.asset_ref, SUM(e.qty_signed) AS quantity
          FROM period p
          JOIN effective_ledger e
            ON e.portfolio_ref = {portfolio_id}
           AND e.leg = 'security'
           AND e.trade_date <= p.period_end
          GROUP BY p.period_end, e.asset_ref
          HAVING SUM(e.qty_signed) <> 0
        ), transfers AS (
          -- ⛔ review-089 ⒀: an IN-KIND transfer moves value across the portfolio's boundary exactly
          -- as a deposit or a withdrawal does, so it is a FLOW. Left out, a fund arriving by transfer
          -- raised total_value with no matching flow and the P&L booked it as PROFIT. Valued at the
          -- SAME price the period's market value uses (the latest price ≤ the period end), so a
          -- transfer inside the period moves the value and not the P&L — and a switch between two
          -- funds of one portfolio (a transfer-out and a transfer-in) nets to ~0 as it should. The
          -- rows carry units and no amount (DistrInfo TON/TOFF), hence a price at all. ⚑ A default
          -- awaiting Bora's ruling — review-089 "The fixes".
          SELECT b.period_end, e.asset_ref,
                 SUM(CASE WHEN e.operation = 'transfer-in' THEN COALESCE(abs(e.quantity), 0)
                          ELSE -COALESCE(abs(e.quantity), 0) END) AS quantity
          FROM bounds b
          JOIN effective_ledger e
            ON e.portfolio_ref = {portfolio_id}
           AND e.leg = 'security'
           AND e.operation IN ('transfer-in', 'transfer-out')
           AND e.trade_date <= b.period_end
           AND e.trade_date > COALESCE(b.prev_end, '-infinity'::date)
          GROUP BY b.period_end, e.asset_ref
        ), valued AS (
          -- holdings and transferred units alike, each at the period's price and in THAT price's
          -- currency; an instrument never priced falls back to its own currency (or XXX, ISO 4217's
          -- "no currency") so it still counts as `missing` somewhere
          SELECT u.period_end, u.kind, u.asset_ref, u.quantity, pr.price, pr.price_date,
                 COALESCE(pr.currency, a.currency, 'XXX') AS currency
          FROM (SELECT period_end, 'holding' AS kind, asset_ref, quantity FROM holdings
                UNION ALL
                SELECT period_end, 'transfer' AS kind, asset_ref, quantity FROM transfers) u
          LEFT JOIN investment_asset a
            ON a.isin = u.asset_ref
          LEFT JOIN LATERAL (
            SELECT p2.price, p2.price_date, p2.currency
            FROM investment_asset_price p2
            WHERE p2.isin = u.asset_ref
              AND p2.price_date <= u.period_end
            ORDER BY p2.price_date DESC
            LIMIT 1
          ) pr ON TRUE
        ), currencies AS (
          SELECT DISTINCT v.currency FROM valued v
          UNION
          SELECT DISTINCT e.currency
          FROM effective_ledger e
          WHERE e.portfolio_ref = {portfolio_id}
            AND e.leg IN ('cash', 'external-flow')
            AND e.currency IS NOT NULL
        ), grid AS (
          -- ⛔ review-089 ⑵: one row per quarter PER CURRENCY. The book has no FX table, so there
          -- is nothing to convert with, and adding CZK to EUR is not an answer. ⚑ A default
          -- awaiting Bora's ruling — review-089 "The fixes".
          SELECT b.period_end, b.partial, b.prev_end, c.currency
          FROM bounds b
          CROSS JOIN currencies c
        ), market AS (
          SELECT period_end, currency,
                 COALESCE(SUM(round(quantity * price, 2)) FILTER (WHERE price IS NOT NULL), 0) AS market_value,
                 COUNT(*) FILTER (WHERE price IS NULL) AS missing_assets,
                 MIN(price_date) FILTER (WHERE price IS NOT NULL) AS oldest_price_date
          FROM valued
          WHERE kind = 'holding'
          GROUP BY period_end, currency
        ), in_kind AS (
          SELECT period_end, currency,
                 COALESCE(SUM(round(quantity * price, 2)) FILTER (WHERE price IS NOT NULL), 0) AS in_kind_flow
          FROM valued
          WHERE kind = 'transfer'
          GROUP BY period_end, currency
        ), cash AS (
          SELECT g.period_end, g.currency, COALESCE(SUM(e.amt_signed), 0) AS cash_balance
          FROM grid g
          LEFT JOIN effective_ledger e
            ON e.portfolio_ref = {portfolio_id}
           AND e.leg = 'cash'
           AND e.currency = g.currency
           AND e.trade_date <= g.period_end
          GROUP BY g.period_end, g.currency
        ), flows AS (
          SELECT g.period_end, g.currency, COALESCE(SUM(e.amt_signed), 0) AS money_flow
          FROM grid g
          LEFT JOIN effective_ledger e
            ON e.portfolio_ref = {portfolio_id}
           AND e.leg = 'external-flow'
           AND e.currency = g.currency
           AND e.trade_date <= g.period_end
           AND e.trade_date > COALESCE(g.prev_end, '-infinity'::date)
          GROUP BY g.period_end, g.currency
        ), per_q AS (
          SELECT g.period_end,
                 g.partial,
                 g.currency,
                 COALESCE(m.market_value, 0) AS market_value,
                 COALESCE(m.missing_assets, 0) AS missing_assets,
                 m.oldest_price_date,
                 c.cash_balance,
                 COALESCE(m.market_value, 0) + c.cash_balance AS total_value,
                 f.money_flow + COALESCE(k.in_kind_flow, 0) AS net_flow_q
          FROM grid g
          JOIN cash  c ON c.period_end = g.period_end AND c.currency = g.currency
          JOIN flows f ON f.period_end = g.period_end AND f.currency = g.currency
          LEFT JOIN market  m ON m.period_end = g.period_end AND m.currency = g.currency
          LEFT JOIN in_kind k ON k.period_end = g.period_end AND k.currency = g.currency
        ), windowed AS (
          SELECT per_q.*, LAG(total_value) OVER (PARTITION BY currency ORDER BY period_end) AS prev_total
          FROM per_q
        )
        SELECT {portfolio_id} AS portfolio_id,
               period_end,
               partial,
               currency,
               market_value,
               cash_balance,
               total_value,
               net_flow_q,
               total_value - prev_total - net_flow_q AS pnl_q,
               CASE WHEN prev_total > 0
                    THEN round((total_value - prev_total - net_flow_q) / prev_total * 100, 6)
                    ELSE NULL END AS return_q_pct,
               CASE WHEN missing_assets > 0 THEN 'missing:' || missing_assets
                    WHEN oldest_price_date < period_end THEN 'stale:' || oldest_price_date
                    ELSE 'full' END AS price_coverage
        FROM windowed
        WHERE prev_total IS NOT NULL
        ORDER BY period_end, currency
    """
    search {
        patterns: [
            "(quarterly|quarter by quarter) (evolution|performance|development)",
            "how (has|did) the portfolio (developed|performed|done) (over|in) (the last )?(quarters|year)",
            "ctvrtletni vyvoj portfolia",
            "jak si portfolio vedlo po ctvrtletich"
        ],
        examples: [
            "How has the portfolio developed over the last four quarters?",
            "Jak se portfolio vyvíjelo za poslední čtyři čtvrtletí?"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" },
        { name: as_of, type: date, label: "As of date (the partial final period)" },
        { name: quarters, type: int, label: "Completed quarters before the as-of row" }
    ]
}

// ⚑IE-15 (a) — ONE PERIOD of `quarterly_evolution`, the part of it the door can run. The report
// renderer calls this once per period end it computed (plus one period before the window, whose
// total the first reported P&L is measured against), and assembles the quarter table from the
// answers. Everything that needs the PREVIOUS period — total, P&L, return, coverage — is the
// renderer's, because the door has no LAG. Its arithmetic is quarterly_evolution's, cut at one
// period: holdings valued at the latest price on or before `to_date` in that price's currency, the
// cash leg to `to_date`, and the flows inside [`from_date`, `to_date`] — money AND in-kind transfers
// at the same price the market value uses (review-089 ⒀).
//
// ⛔ One line per contribution, then ONE GROUP BY. The reference query builds a period × currency
// grid and aggregates with FILTER (WHERE …); neither survives the door. Here each holding, transfer,
// cash movement and flow becomes a line carrying its currency and its share of each column, and the
// lines are summed per currency — so a currency is a row exactly when something in it is held or
// moves. The renderer fills the other currencies' zeros.
//
// ⛔ Every money column is CAST to FLOAT in every branch of the UNION (S2.3·D19): a branch that
// contributed a bare `numeric` would leave PostgreSQL typing the union column as an UNCONSTRAINED
// `numeric`, which worker-postgres reads at scale 0. FLOAT is the one spelling both parsers take.
//
// ⛔ The HOLDINGS branch stays FIRST in `lines`. The door emits the other branches'
// `CAST(NULL AS DATE)` as a bare NULL (measured through ttr-translator 0.10.1, IE-P3·S3.1), so the
// union's date type comes from the first branch's real `price_date` column. Reorder the branches and
// re-run the door probe before trusting psql's word for it.
def query period_values {
    description: "One period of the portfolio, currency by currency: what its holdings were worth at the period end at the last known prices, the cash it held, the money and in-kind transfers that crossed its boundary during the period, and how many holdings had no price at all."
    language: SQL
    sourceText: """
        WITH effective_ledger AS (
          SELECT t.*,
                 CASE
                   WHEN t.leg = 'security' AND t.operation IN ('buy', 'transfer-in', 'reversal-of-sell')
                     THEN  COALESCE(abs(t.quantity), 0)
                   WHEN t.leg = 'security' AND t.operation IN ('sell', 'transfer-out', 'payout', 'reversal-of-buy')
                     THEN -COALESCE(abs(t.quantity), 0)
                   ELSE 0
                 END AS qty_signed,
                 CASE
                   WHEN t.leg = 'cash'          AND t.operation = 'credit'     THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'cash'          AND t.operation = 'debit'      THEN -COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'deposit'    THEN  COALESCE(abs(t.amount), 0)
                   WHEN t.leg = 'external-flow' AND t.operation = 'withdrawal' THEN -COALESCE(abs(t.amount), 0)
                   ELSE 0
                 END AS amt_signed
          FROM investment_transaction t
          WHERE t.reversal_of IS NULL
            AND NOT EXISTS (SELECT 1 FROM investment_transaction r WHERE r.reversal_of = t.external_id)
        )
        , holdings AS (
          SELECT asset_ref, SUM(qty_signed) AS quantity
          FROM effective_ledger
          WHERE portfolio_ref = {portfolio_id}
            AND leg = 'security'
            AND trade_date <= {to_date}
          GROUP BY asset_ref
          HAVING SUM(qty_signed) <> 0
        ), transfers AS (
          -- ⛔ review-089 ⒀: an in-kind transfer crosses the portfolio's boundary as a deposit does,
          -- so it is a FLOW, valued at the price the period's market value uses. The rows carry units
          -- and no amount (DistrInfo TON/TOFF), hence a price at all.
          SELECT asset_ref,
                 SUM(CASE WHEN operation = 'transfer-in' THEN COALESCE(abs(quantity), 0)
                          ELSE -COALESCE(abs(quantity), 0) END) AS quantity
          FROM effective_ledger
          WHERE portfolio_ref = {portfolio_id}
            AND leg = 'security'
            AND operation IN ('transfer-in', 'transfer-out')
            AND trade_date >= {from_date}
            AND trade_date <= {to_date}
          GROUP BY asset_ref
        ), latest_price AS (
          -- positions_at's grouped-MAX-joined-back, for the reasons recorded there (no LATERAL, no
          -- correlated MAX), and `price_currency` for the reason recorded there (never two columns of
          -- one name in a row the door carries).
          SELECT ap.isin, ap.price, ap.price_date, ap.currency AS price_currency
          FROM investment_asset_price ap
          JOIN (SELECT p2.isin AS isin, MAX(p2.price_date) AS as_of_price_date
                  FROM investment_asset_price p2
                 WHERE p2.price_date <= {to_date}
                 GROUP BY p2.isin) m
            ON m.isin = ap.isin
           AND m.as_of_price_date = ap.price_date
        ), lines AS (
          -- a holding: its value in its price's currency; never priced, it counts as missing and
          -- falls back to the instrument's own currency, or XXX (ISO 4217's "no currency")
          SELECT COALESCE(pr.price_currency, a.currency, 'XXX') AS currency,
                 CAST(COALESCE(h.quantity * pr.price, 0) AS FLOAT) AS market_value,
                 CAST(0 AS FLOAT) AS cash_balance,
                 CAST(0 AS FLOAT) AS net_flow,
                 CASE WHEN pr.price IS NULL THEN 1 ELSE 0 END AS missing_assets,
                 pr.price_date AS price_date
          FROM holdings h
          LEFT JOIN investment_asset a
            ON a.isin = h.asset_ref
          LEFT JOIN latest_price pr
            ON pr.isin = h.asset_ref
          UNION ALL
          -- a transfer in kind: a flow, at the same price
          SELECT COALESCE(pr.price_currency, a.currency, 'XXX'),
                 CAST(0 AS FLOAT),
                 CAST(0 AS FLOAT),
                 CAST(COALESCE(x.quantity * pr.price, 0) AS FLOAT),
                 0,
                 CAST(NULL AS DATE)
          FROM transfers x
          LEFT JOIN investment_asset a
            ON a.isin = x.asset_ref
          LEFT JOIN latest_price pr
            ON pr.isin = x.asset_ref
          UNION ALL
          -- the cash leg, to the period end
          SELECT currency, CAST(0 AS FLOAT), CAST(amt_signed AS FLOAT), CAST(0 AS FLOAT), 0, CAST(NULL AS DATE)
          FROM effective_ledger
          WHERE portfolio_ref = {portfolio_id}
            AND leg = 'cash'
            AND currency IS NOT NULL
            AND trade_date <= {to_date}
          UNION ALL
          -- the external-flow leg, inside the period — never summed into cash, which would count
          -- every deposit twice
          SELECT currency, CAST(0 AS FLOAT), CAST(0 AS FLOAT), CAST(amt_signed AS FLOAT), 0, CAST(NULL AS DATE)
          FROM effective_ledger
          WHERE portfolio_ref = {portfolio_id}
            AND leg = 'external-flow'
            AND currency IS NOT NULL
            AND trade_date >= {from_date}
            AND trade_date <= {to_date}
        )
        SELECT currency,
               SUM(market_value) AS market_value,
               SUM(cash_balance) AS cash_balance,
               SUM(net_flow) AS net_flow,
               SUM(missing_assets) AS missing_assets,
               MIN(price_date) AS oldest_price_date
        FROM lines
        GROUP BY currency
        ORDER BY currency
    """
    search {
        patterns: [
            "(portfolio )?value (at|on) the end of (a|the) period",
            "(net )?(inflows|outflows|flows) (in|during) (the )?period",
            "hodnota portfolia ke konci obdobi",
            "vklady a vybery za obdobi"
        ],
        examples: [
            "What was the portfolio worth at the end of the period, and what flowed in?",
            "Jaká byla hodnota portfolia na konci období a co do něj přiteklo?"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" },
        { name: from_date, type: date, label: "First day of the period (inclusive)" },
        { name: to_date, type: date, label: "Last day of the period (inclusive)" }
    ]
}

def query portfolio_header {
    description: "The name of a portfolio, its client and its base currency, as they stand now — the title block of a report about it."
    language: SQL
    sourceText: """
        -- A LEFT join: a portfolio whose client row is missing still has a name. And a portfolio the
        -- book holds NO row for answers nothing at all — the ledger can name a portfolio the valuation
        -- leg never described — so the report names it by its id rather than failing.
        SELECT p.external_id   AS portfolio_id,
               p.label         AS portfolio_name,
               c.name          AS client_name,
               p.base_currency
        FROM investment_portfolio p
        LEFT JOIN investment_client c
          ON c.external_id = p.client_ref
         AND c.valid_to IS NULL
        WHERE p.valid_to IS NULL
          AND p.external_id = {portfolio_id}
        ORDER BY p.external_id
    """
    search {
        patterns: [
            "(which|what) portfolio is (this|it)",
            "(name|owner|base currency) of (the|this) portfolio",
            "nazev portfolia a jmeno klienta",
            "ktera mena je zakladni pro portfolio"
        ],
        examples: [
            "Which portfolio is this, and whose is it?",
            "Čí je toto portfolio a jak se jmenuje?"
        ]
    }
    parameters: [
        { name: portfolio_id, type: text, label: "Portfolio id (conseq:<ContractId>)" }
    ]
}
