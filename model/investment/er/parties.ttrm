package investment

model er

// The interpreted face: WHO. Clients and their portfolios, as Midas needs them (IE-C23) — not as
// the book stores them.
//
// ⚑ THE DESCRIPTIONS ARE THE PRODUCT. The Golem reads this model with resolution off, so an
// attribute's description is the whole of what it knows about that attribute; and a Czech CFO reads
// the `cs` half in the Studio. Both are written for a reader, not for a schema dump: what the value
// MEANS, its unit or currency, the shape of its id, the vocabulary it is drawn from. An attribute
// whose description repeats its own name is a failure and `er-layer.test.mjs` T1.3 treats it as one.
//
// ⚑ WHAT IS DELIBERATELY NOT HERE: `valid_to`, and `sk`. The SCD2 plumbing is the book's business,
// not Midas's — a person asking "which portfolios lost value" must never have to know that a
// portfolio is stored as a chain of versions. The current-row rule (`valid_to IS NULL`) therefore
// lives in the query text, and only there (IE-C24 / IE-P0 V9: the binding CANNOT carry it —
// `whereFilter` parses and is then dropped before it reaches translate, so writing one would be a
// rule the model claims and does not enforce).

def entity client {
    description: {
        en: "Clients of the distributor — the people and companies whose money is in the portfolios below.",
        cs: "Klienti distributora — lidé a firmy, jejichž peníze jsou v níže uvedených portfoliích."
    }
    labelPlural: "Clients"
    nameAttribute: name
    codeAttribute: client_id
    roles: [dimension]
    displayLabel: { en: "Client", cs: "Klient" }
    attributes: [
        def attribute client_id {
            type: text, isKey: true,
            description: {
                en: "The client's identifier at the distributor, in the form `conseq:<CsqClientId>` — the code to filter by when someone names a client.",
                cs: "Identifikátor klienta u distributora ve tvaru `conseq:<CsqClientId>` — kód, podle kterého se filtruje, když někdo jmenuje klienta."
            }
        },
        def attribute name {
            type: text,
            description: {
                en: "The client's name as the distributor holds it. The human-readable label; personal data.",
                cs: "Jméno klienta tak, jak je vede distributor. Čitelné označení; osobní údaj."
            }
        },
        def attribute contact_email {
            type: text,
            description: {
                en: "Contact e-mail address on record for the client. Personal data.",
                cs: "Kontaktní e-mailová adresa evidovaná u klienta. Osobní údaj."
            }
        },
        def attribute tax_country {
            type: text,
            description: {
                en: "Country of tax residence as an ISO 3166-1 alpha-3 code (`CZE`, `SVK`) — three letters, not two.",
                cs: "Země daňové rezidence jako kód ISO 3166-1 alpha-3 (`CZE`, `SVK`) — tři písmena, nikoli dvě."
            }
        },
        def attribute since {
            type: date,
            description: {
                en: "The day the currently recorded details became true. It dates the RECORD, not the relationship: a change of address moves it.",
                cs: "Den, od kterého platí aktuálně evidované údaje. Datuje ZÁZNAM, nikoli vztah: změna adresy jej posune."
            }
        }
    ]
}

def entity portfolio {
    description: {
        en: "Portfolios — one per Conseq contract. The unit a report is written about and the unit a client asks about.",
        cs: "Portfolia — jedno na každou smlouvu Conseq. Jednotka, o které se píše report a na kterou se klient ptá."
    }
    labelPlural: "Portfolios"
    nameAttribute: name
    codeAttribute: portfolio_id
    roles: [dimension]
    displayLabel: { en: "Portfolio", cs: "Portfolio" }
    attributes: [
        def attribute portfolio_id {
            type: text, isKey: true,
            description: {
                en: "The contract identifier, in the form `conseq:<ContractId>` (for example `conseq:100003369`) — this is what a person means by \"contract number\".",
                cs: "Identifikátor smlouvy ve tvaru `conseq:<ContractId>` (například `conseq:100003369`) — právě tohle myslí člověk pojmem „číslo smlouvy“."
            }
        },
        def attribute client {
            type: text,
            description: {
                en: "The client this portfolio belongs to, held as their `conseq:` client identifier.",
                cs: "Klient, kterému portfolio patří, vedený jeho identifikátorem `conseq:`."
            }
        },
        def attribute name {
            type: text,
            description: {
                en: "The portfolio's name as the distributor labels it — usually a product or strategy name, not the client's.",
                cs: "Název portfolia tak, jak jej označuje distributor — obvykle název produktu nebo strategie, nikoli klienta."
            }
        },
        def attribute base_currency {
            type: text,
            description: {
                en: "The currency the portfolio reports in, ISO 4217 (`CZK`, `EUR`). Values and balances are expressed in it.",
                cs: "Měna, ve které portfolio reportuje, ISO 4217 (`CZK`, `EUR`). Hodnoty a zůstatky jsou v ní vyjádřeny."
            }
        },
        def attribute state {
            type: text,
            description: {
                en: "Contract state as the distributor reports it — whether the portfolio is live, suspended or terminated.",
                cs: "Stav smlouvy tak, jak jej hlásí distributor — zda portfolio běží, je pozastaveno nebo ukončeno."
            }
        },
        def attribute since {
            type: date,
            description: {
                en: "The day the currently recorded contract details became true. It dates the RECORD, not the contract's start.",
                cs: "Den, od kterého platí aktuálně evidované údaje smlouvy. Datuje ZÁZNAM, nikoli začátek smlouvy."
            }
        }
    ]
}

// Portfolio → client. Bound in `binding/er2db.ttrm` (an er2db_relation onto `fk_portfolio_client`),
// never inline: the lint treats an inline `binding:` PLUS an explicit map as an error on both, and
// one file holding every binding is what makes the binding reviewable.
def relation rel_portfolio_client {
    from: er.entity.portfolio, to: er.entity.client,
    cardinality: { from: "0..*", to: "1" }
}
