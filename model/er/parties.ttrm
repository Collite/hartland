package hartland

model er

// Customers + their addresses/demographics, and Stores (D-5).

def entity customer {
    description: "Customers — the channel-overlap and demographic branches key off this entity."
    labelPlural: "Customers"
    codeAttribute: customer_id
    roles: [master, dimension]
    displayLabel: { en: "Customer", cs: "Zákazník" }
    attributes: [
        def attribute sk          { type: int, isKey: true, description: "Sequence key. Internal primary key only." },
        def attribute customer_id { type: text, description: "Unique customer identifier (code)." },
        def attribute addr        { type: int, description: "Current address — FK to the 'sk' attribute of the Customer Address entity." },
        def attribute cdemo       { type: int, description: "Customer demographics — FK to the 'sk' attribute of the Customer Demographics entity." },
        def attribute hdemo       { type: int, description: "Household demographics — FK to the 'sk' attribute of the Household Demographics entity." },
        def attribute birth_year  { type: int, description: "Customer's year of birth — buyer-age analyses derive age from this." }
    ]
}

def entity customer_address {
    description: "Customer addresses — the regional-dying branch (revenue-by-state, confirmed flat)."
    labelPlural: "Customer Addresses"
    nameAttribute: city
    codeAttribute: address_id
    roles: [dimension]
    displayLabel: { en: "Customer Address", cs: "Adresa zákazníka" }
    attributes: [
        def attribute sk         { type: int, isKey: true, description: "Sequence key. Internal primary key only." },
        def attribute address_id { type: text, description: "Unique address identifier (code)." },
        def attribute city       { type: text, description: "City of the address." },
        def attribute county     { type: text, description: "County of the address." },
        def attribute state      { type: { type: char, length: 2 }, description: "Two-letter US state code of the address — revenue-by-state slices use this." }
    ]
}

def entity customer_demographics {
    description: "Customer demographics — the demographic-dying branch (buyer age, confirmed flat)."
    labelPlural: "Customer Demographics"
    roles: [dimension]
    displayLabel: { en: "Customer Demographics", cs: "Demografie zákazníka" }
    attributes: [
        def attribute sk             { type: int, isKey: true, description: "Sequence key. Internal primary key only." },
        def attribute gender         { type: { type: char, length: 1 }, description: "Gender code (M/F)." },
        def attribute marital_status { type: { type: char, length: 1 }, description: "Marital status code (single letter, e.g. S/M/D)." }
    ]
}

def entity household_demographics {
    description: "Household demographics — the demographic-dying branch."
    labelPlural: "Household Demographics"
    roles: [dimension]
    displayLabel: { en: "Household Demographics", cs: "Demografie domácnosti" }
    attributes: [
        def attribute sk            { type: int, isKey: true, description: "Sequence key. Internal primary key only." },
        def attribute income_band   { type: int, description: "Income band — FK to the 'sk' attribute of the Income Band entity." },
        def attribute buy_potential { type: text, description: "Household buying-potential label (e.g. '>10000', 'Unknown')." }
    ]
}

def entity income_band {
    description: "Income bands."
    labelPlural: "Income Bands"
    roles: [dimension]
    displayLabel: { en: "Income Band", cs: "Příjmové pásmo" }
    attributes: [
        def attribute sk          { type: int, isKey: true, description: "Sequence key. Internal primary key only." },
        def attribute lower_bound { type: int, description: "Lower bound of the household's yearly income range (USD)." },
        def attribute upper_bound { type: int, description: "Upper bound of the household's yearly income range (USD)." }
    ]
}

def entity store {
    description: "Stores — the six TN stores (Stores-channel dim)."
    labelPlural: "Stores"
    nameAttribute: store_name
    codeAttribute: store_id
    roles: [dimension]
    displayLabel: { en: "Store", cs: "Prodejna" }
    attributes: [
        def attribute sk         { type: int, isKey: true, description: "Sequence key. Internal primary key only." },
        def attribute store_id   { type: text, description: "Unique store identifier (code)." },
        def attribute store_name { type: text, description: "Store name, the human-readable label." },
        def attribute city       { type: text, description: "The city the store is located in." },
        def attribute state      { type: { type: char, length: 2 }, description: "The state the store is located in." }
    ]
}
