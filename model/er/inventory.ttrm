package hartland

model er

// Inventory Snapshots — the smoking gun (S1) — and its Distribution Center dim (D-5).

def entity inventory {
    description: "Weekly warehouse-level on-hand snapshots per warehouse and item."
    roles: [fact]
    displayLabel: { en: "Inventory Snapshots", cs: "Stavy zásob" }
    attributes: [
        def attribute as_of_date       { type: int, isKey: true, description: "Weekly snapshot date. This entity is only semi-additive - stock levels MUST NOT be added across snapshots." },
        def attribute item             { type: int, isKey: true, description: "Item primary key (the 'sk' attribute of the Item entity)" },
        def attribute warehouse        { type: int, isKey: true, description: "Warehouse primary key (the 'sk' attribute of the Warehouse entity)" },
        def attribute quantity_on_hand { type: int, description: "Quantity on hand of the given item at the time of the snapshot." }
    ]
}

def entity warehouse {
    description: "Distribution Centers"
    nameAttribute: warehouse_name
    codeAttribute: warehouse_id
    roles: [dimension]
    displayLabel: { en: "Distribution Center", cs: "Distribuční centrum" }
    attributes: [
        def attribute sk              { type: int, isKey: true, description: "Warehouse primary key. Internal sequence key only." },
        def attribute warehouse_id    { type: text, description: "Warehouse ID (unique code)" },
        def attribute warehouse_name  { type: text, description: "Warehouse name, the human-readable label" },
        def attribute city            { type: text, description: "The city the warehouse is located in" },
        def attribute state           { type: { type: char, length: 2 }, description: "The state the warehouse is located in" }
    ]
}
